<%- include partials/header.ejs %>
<%- include partials/main_nav.ejs %>
<div class="container" style="max-width: 600px;">
    <h1 class="mb-4 text-center">Contact Me!</h1>

    <form action="mailto:mikayla.rojas@ontariotechu.net" method="post" enctype="text/plain" name="form"> 
         <p> <!--Writing form fields as paragraph content-->
                <label for="name">Name:</label> <!--Defines the label (what will be displayed in front of form field) for the input field "name"-->
                <input type="text" name="name" size="32" id="name" required placeholder="Your name here"> <!--Defines a REQUIRED single-line text field called "name", which is 32 characters long and defines a placeholder to aid the user-->
            </p> <!--Closing paragraph text for this form field-->
            <p>
                <label for="email">Email:</label> <!--Defines label for the "email" input field-->
                <input name="email" type="email" size="40" id="email" required placeholder="youremail@example.com"> <!--Defines a REQUIRED single-line input field for email, the size is 40 characters, and defines placeholder text-->
            </p>
            <!--Adding "required" to a form field means that the form will not submit if that field is empty-->
            <p>
                <label for ="phone">Phone number:</label> <!--Defines label for the "phone" input field-->
                <!--Defines the input field for a phone number, including a required field and data validation, meaning the phone number must be present and in the format: 123-456-7890-->
                <!--"pattern" does the data validation-->
                <input name="phone" type="tel" id="phone" required placeholder="123-456-7890" pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}"> <!--"pattern" adapted from https://www.w3schools.com/tags/att_input_type_tel.asp-->
            </p>
            <p>
                <label for="comments">Comments?</label><br> <!--Label for the "comments" input field, which is a textarea box-->
                <!--<br> creates a line break, placing the textarea on the line below the label-->
                <!--"Comments" input field is not required, meaning users can submit the form even if they do not have any comments to share-->
                <textarea name="comments" cols="60" rows="6" id="comments" placeholder="Share any of your thoughts here!"></textarea> <!--Defines a textarea box input field, which is a multiline text input area that is 60 characters per row and 6 rows long.-->
            </p>
            <p><input type="submit" value="Click here to submit the form"></p> <!--Submit button, when clicked the form will submit-->
    </form>
</div>




